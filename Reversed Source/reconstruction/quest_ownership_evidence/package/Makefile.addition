QUEST_OWNERSHIP_OBJECTS = $(filter-out target_walk_desc_output_syscalls.o,$(TARGET_WALKING_OBJECTS)) quest_ownership_desc_output_syscalls.o
quest_ownership_regression$(EXEEXT): quest_ownership_regression.cpp $(TARGET_WALKING_SOURCES) $(QUEST_OWNERSHIP_OBJECTS) ../../game/src/event.cpp ../../game/src/event_queue.cpp $(LUA_SDK_LIBRARIES)
	$(CXX) -DMCNCC_TEST_REAL_EVENTS -Ifdwatch_shim -Isocket_shim -Iposix_shim $(ITEM_SOCKET_FLAGS) $(CPPFLAGS) $(CXXFLAGS) -Wno-long-long quest_ownership_regression.cpp $(TARGET_WALKING_SOURCES) $(QUEST_OWNERSHIP_OBJECTS) ../../game/src/event.cpp ../../game/src/event_queue.cpp $(LDFLAGS) -o $@
quest_ownership_desc_output_syscalls.o: quest_ownership_desc_output_syscalls.c desc_output_syscalls.c
	$(CC) -Ifdwatch_shim -Isocket_shim -Iposix_shim $(CPPFLAGS) $(CFLAGS) -UNDEBUG -c quest_ownership_desc_output_syscalls.c -o $@
.PHONY: check-quest-ownership check-quest-ownership-abi clean-quest-ownership
check-quest-ownership: quest_ownership_regression$(EXEEXT)
	./quest_ownership_regression$(EXEEXT)
check-abi: check-quest-ownership-abi
check-quest-ownership-abi: quest_ownership_abi.cpp ../../game/src/questmanager.h
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -m32 -fsyntax-only quest_ownership_abi.cpp
clean: clean-quest-ownership
clean-quest-ownership:
	$(RM) quest_ownership_regression$(EXEEXT) quest_ownership_desc_output_syscalls.o

