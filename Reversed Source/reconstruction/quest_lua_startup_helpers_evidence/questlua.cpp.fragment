namespace quest {
void CQuestManager::AddLuaFunctionTable(const char* name, luaL_reg* entries)
{
    lua_newtable(L);
    while (entries->name) {
        lua_pushstring(L, entries->name);
        const lua_CFunction function = entries->func;
        ++entries;
        lua_pushcfunction(L, function);
        lua_rawset(L, -3);
    }
    lua_setglobal(L, name);
}

void CQuestManager::BuildStateIndexToName(const char* questName)
{
    const int savedTop = lua_gettop(L);
    lua_getglobal(L, questName);
    if (lua_isnil(L, -1)) {
        CQuestManager::instance().QuestError("BuildStateIndexToName", 1740,
                                             "QUEST wrong quest state file for quest %s", questName);
    } else {
        lua_pushnil(L);
        while (lua_next(L, -2)) {
            if (lua_isstring(L, -2) && lua_isnumber(L, -1)) {
                lua_pushvalue(L, -2);
                lua_rawset(L, -4);
            } else {
                lua_pop(L, 1);
            }
        }
    }
    lua_settop(L, savedTop);
}
}
